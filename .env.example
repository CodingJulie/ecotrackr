# ─── Supabase (обязательно) ───────────────────────────────────────────────
# URL проекта: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — безопасен для клиента
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ─── Сайт (опционально) ───────────────────────────────────────────────────
# Базовый URL для sitemap, OG-тегов и shareable-ссылок
# NEXT_PUBLIC_SITE_URL=https://ecotrackr.com

# ─── AI Insights (опционально) ──────────────────────────────────────────────
# Google Gemini API key — только на сервере, НЕ добавляйте в NEXT_PUBLIC_*
# Без ключа /api/ai-insights вернёт локализованные fallback-советы
# GEMINI_API_KEY=your-gemini-api-key
